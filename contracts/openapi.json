        "additionalProperties": false,
        "type": "object",
        "required": [
          "battery_capacity_kwh",
          "initial_battery_kwh",
          "reserve_kwh",
          "pv_capacity_kw",
          "charge_efficiency",
          "discharge_efficiency",
          "max_charge_kw",
          "max_discharge_kw",
          "additional_critical_kw"
        ],
        "title": "EffectiveConfig"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
