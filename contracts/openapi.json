            "title": "Reserve Kwh"
          },
          "pv_capacity_kw": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Pv Capacity Kw"
          },
          "charge_efficiency": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Charge Efficiency"
          },
          "discharge_efficiency": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Discharge Efficiency"
          },
          "max_charge_kw": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Max Charge Kw"
          },
          "max_discharge_kw": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Max Discharge Kw"
          },
          "additional_critical_kw": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Additional Critical Kw"
          }
