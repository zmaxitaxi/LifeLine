        "additionalProperties": false,
        "type": "object",
        "required": [
          "hour",
          "pv_kwh",
          "critical_requested_kwh",
          "critical_served_kwh",
          "critical_unserved_kwh",
          "flexible_planned_kwh",
          "flexible_served_kwh",
          "flexible_unserved_kwh",
          "charge_input_kwh",
          "discharge_output_kwh",
          "curtailed_kwh",
